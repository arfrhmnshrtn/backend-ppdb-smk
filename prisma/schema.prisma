generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model students {
  id                   Int                    @id @default(autoincrement())
  id_user              Int                    @unique
  no_daftar            String
  nama                 String
  no_hp                String
  nisn                 String
  asal_sekolah         String
  akreditasi_sekolah   String
  alamat               String
  foto                 String?
  jurusan              Jurusan
  jurusan_pilihan_1    Jurusan?
  jurusan_pilihan_2    Jurusan?
  created_at           DateTime               @default(now())
  verification_status  VerificationStatus     @default(BELUM_SUBMIT)
  documents            documents[]
  user                 user                   @relation(fields: [id_user], references: [id])
  raporScores          RaporScore[]
  nilaiScore           nilai_scores?
  studentAnnouncements  student_announcements?
  studentRanking        student_ranking?
  whatsappNotifications whatsapp_notifications[]
}

model document_types {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  documents documents[]
}

model documents {
  id               String         @id @default(cuid())
  id_student       Int
  id_document_type Int
  file_path        String
  status           StatusDocument @default(PENDING)
  keterangan       String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  document_type    document_types @relation(fields: [id_document_type], references: [id], onDelete: Cascade)
  student          students       @relation(fields: [id_student], references: [id], onDelete: Cascade)

  @@index([id_document_type], map: "documents_id_document_type_fkey")
  @@index([id_student], map: "documents_id_student_fkey")
}

model user {
  id        Int       @id @default(autoincrement())
  no_hp     String    @unique(map: "User_no_hp_key")
  username  String?   @unique(map: "User_username_key")
  name      String?
  password  String
  createdAt DateTime  @default(now())
  role      user_role @default(USER)
  students  students?
}

model registration_otps {
  id                  String    @id @default(cuid())
  phone_number        String    @unique(map: "RegistrationOtp_phone_number_key")
  registration_data   Json
  otp_hash            String
  expires_at          DateTime
  attempts            Int       @default(0)
  resend_available_at DateTime
  verified_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
}

model test_schedules {
  id           Int      @id @default(autoincrement())
  tanggal_test DateTime
  jam_test     String
  lokasi_test  String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

enum VerificationStatus {
  BELUM_SUBMIT
  MENUNGGU_VALIDASI
  REVISI
  TERVERIFIKASI
  DITOLAK
}

enum Jurusan {
  TKJ
  TKR
  ATP
  AK
  DKV
}

enum StatusDocument {
  PENDING
  APPROVED
  REVISI
  REJECTED
}

enum user_role {
  USER
  ADMIN
}

model RaporScore {
  id         Int @id @default(autoincrement())
  id_student Int

  semester_1 Float
  semester_2 Float
  semester_3 Float
  semester_4 Float
  semester_5 Float

  prestasi Int @default(0)

  rata_rata   Float @default(0)
  nilai_akhir Float @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student students @relation(fields: [id_student], references: [id], onDelete: Cascade)

  @@unique([id_student], map: "rapor_scores_id_student_unique")
  @@index([id_student], map: "rapor_scores_id_student_fkey")
}

model nilai_scores {
  id         String @id @default(cuid())
  student_id Int    @unique

  math_score      Int
  indonesia_score Int
  english_score   Int
  religion_score  Int

  average_score Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

enum JalurPenerimaan {
  PILIHAN_1
  PILIHAN_2
}

enum StatusAkhirSeleksi {
  DITERIMA
  TIDAK_DITERIMA
}

model student_ranking {
  id                    String              @id @default(cuid())
  id_student            Int                 @unique
  final_score           Float
  nilai_rapor           Float               @default(0)
  nilai_rata_rata_rapor Float               @default(0)
  nilai_ujian           Float               @default(0)
  ranking               Int
  jurusan               Jurusan
  jurusan_pilihan_1     Jurusan?
  jurusan_pilihan_2     Jurusan?
  jurusan_diterima      Jurusan?
  jalur_penerimaan      JalurPenerimaan?
  status_akhir          StatusAkhirSeleksi  @default(TIDAK_DITERIMA)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  student               students            @relation(fields: [id_student], references: [id], onDelete: Cascade)

  @@map("student_ranking")
}

model student_announcements {
  id         String @id @default(cuid())
  id_student Int    @unique

  status           StudentAnnouncementStatus @default(PENDING)
  jurusan_diterima Jurusan?
  jalur_penerimaan JalurPenerimaan?

  published_at DateTime?
  is_published Boolean   @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  student students @relation(fields: [id_student], references: [id], onDelete: Cascade)
}

enum StudentAnnouncementStatus {
  PENDING
  PASSED
  FAILED
  RESERVE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model whatsapp_notifications {
  id                 String             @id @default(cuid())
  id_student         Int
  phone_number       String
  message            String             @db.Text
  validation_summary Json?
  status             NotificationStatus @default(PENDING)
  attempts           Int                @default(0)
  fonnte_response    String?            @db.Text
  sent_at            DateTime?
  last_attempt_at    DateTime?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  student            students           @relation(fields: [id_student], references: [id], onDelete: Cascade)

  @@index([id_student], map: "whatsapp_notifications_id_student_fkey")
}

model major_quotas {
  id         Int      @id @default(autoincrement())
  jurusan    Jurusan  @unique(map: "MajorQuota_jurusan_key")
  quota      Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
