model students {
  id           Int      @id @default(autoincrement())
  id_user      Int      @unique
  no_daftar    String
  nama         String
  no_hp        String
  nisn         String
  asal_sekolah String
  alamat       String
  jurusan      Jurusan
  // status_berkas StatusBerkas @default(PENDING)
  created_at   DateTime @default(now())

  verification_status VerificationStatus @default(BELUM_SUBMIT)

  user      User        @relation(fields: [id_user], references: [id])
  documents documents[]
}

enum VerificationStatus {
  BELUM_SUBMIT
  MENUNGGU_VALIDASI
  REVISI
  TERVERIFIKASI
  DITOLAK
}

// enum StatusBerkas {
//   PENDING
//   APPROVED
//   REVISI
//   REJECTED
// }

enum Jurusan {
  TKJ
  TKR
  ATP
  AK
  DKV
}

model document_types {
  id   Int    @id @default(autoincrement())
  name String @unique

  documents documents[]
}

model documents {
  id               String         @id @default(cuid())
  id_student       Int
  id_document_type Int
  file_path        String
  status           StatusDocument @default(PENDING)
  keterangan       String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  student       students       @relation(fields: [id_student], references: [id], onDelete: Cascade)
  document_type document_types @relation(fields: [id_document_type], references: [id], onDelete: Cascade)
}

enum StatusDocument {
  PENDING
  APPROVED
  REVISI
  REJECTED
}
